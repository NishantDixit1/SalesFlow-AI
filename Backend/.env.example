# ---- SalesFlow AI CRM backend env ----

# Port the API listens on (Render/Railway inject this automatically in prod)
PORT=8000

# Node environment
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas)
# e.g. mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/salesflow
MONGO_URI=

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Deployed frontend URL, used for CORS (no trailing slash)
# In dev: http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- AI (optional) ----
# The CRM's AI features (email drafts, lead insights) use OpenRouter.
# Get a key at https://openrouter.ai/keys . Leave blank to disable AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
